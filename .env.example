# Optional. Needed only for local provider ingestion; tests and the public-mode demo need no credentials.
# football-data.org token for Arsenal ingestion.
FOOTBALL_DATA_API_KEY=
# Sportradar evaluation-trial key for Texans (NFL v7) and Scottie (Golf) ingestion. Local use only.
SPORTRADAR_API_KEY=
# Server source policy: "true" excludes restricted provider data and serves labelled demo data. Unset or "false" for local development.
SPORTS_BRIEFING_PUBLIC_MODE=
# SQLite database path. Defaults to data/sports_briefing.sqlite3 relative to the working directory.
SPORTS_BRIEFING_DATABASE=
