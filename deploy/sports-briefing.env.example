# Copy to /etc/sports-briefing.env (root:sports-briefing, mode 0640).
# The first public deployment needs no provider credentials. Do not add
# FOOTBALL_DATA_API_KEY or SPORTRADAR_API_KEY until public use is cleared.
SPORTS_BRIEFING_PUBLIC_MODE=true
SPORTS_BRIEFING_DATABASE=/var/lib/sports-briefing/sports_briefing.sqlite3
